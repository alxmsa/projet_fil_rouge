# Copier ce fichier en `.env` (jamais commité) avant tout `docker compose up`.

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_USER=todo_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=todo_db

# --- API Node ------------------------------------------------------------
API_PORT=3000
CORS_ORIGIN=*
JSON_BODY_LIMIT=100kb
DB_CONNECT_RETRIES=10
DB_CONNECT_DELAY_MS=2000

# --- Service de stats Python ---------------------------------------------
STATS_PORT=5000

# --- Registry (utilisé par docker-compose.prod.yml et scripts/publish) ---
DOCKERHUB_USER=votre-user-dockerhub
REGISTRY=docker.io
IMAGE_TAG=latest
